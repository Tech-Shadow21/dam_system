# Vaultra — environment variables (see 02-technical-architecture.md)
# Copy to .env.local and fill in real values. .env.local is git-ignored.

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Storage ---
# Non-secret: name of the bucket holding asset binaries and generated variants.
# Replaces the former R2_* variables (see memory.md decisions log).
SUPABASE_STORAGE_BUCKET=vaultra-assets

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign/validate share tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_LINK_SIGNING_SECRET=generate-a-32-byte-hex-secret
